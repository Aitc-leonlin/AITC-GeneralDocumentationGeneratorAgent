flowchart TD
    %% Report conversation page: five API routes and four compiled LangGraphs.
    %% Dotted edges represent one graph node invoking another graph.
    UI_REPORT["前端：報告對話頁"]

    subgraph THREAD_APIS["對話與 Thread"]
        API_THREADS["GET /api/report-generator/threads"] --> LIST_THREADS["依使用者 ID 讀取 Thread 清單"]
        LIST_THREADS --> THREADS_RESULT["回傳既有對話"]

        API_MESSAGE["POST /api/report-generator/threads/{thread_id}/messages"] --> READ_STATE["讀取既有 Thread 或建立新對話狀態"]
        SAVE_STATE["儲存訊息、計畫、大綱與 LLM 紀錄"]
        SAVE_STATE --> MESSAGE_RESULT["回傳 Thread 與實際 Graph 節點路徑"]

        API_DELETE["DELETE /api/report-generator/threads/{thread_id}"] --> DELETE_STATE["依 Thread ID 與使用者 ID 刪除"]
        DELETE_STATE --> DELETE_RESULT["回傳刪除結果"]
    end

    subgraph OUTLINE_GRAPH["_OUTLINE_GRAPH｜對話入口"]
        O_START((START)) --> O_LOAD["load_context"]
        O_LOAD --> O_CLASSIFY["classify_question"]
        O_INTENT{"分類的 intent"}
        O_INTENT -- ask_question / out_of_scope --> O_ANSWER["answer_question"]
        O_INTENT -- create_report / revise_report --> O_ASSESS["assess_readiness"]
        O_ASSESS --> O_READY{"需要追問？"}
        O_READY -- 是 --> O_CLARIFY["clarify"]
        O_READY -- 否 --> O_SOURCE["resolve_source_mode"]
        O_SOURCE --> O_CLASSIFIED["classified"]
        O_ANSWER --> O_END((END))
        O_CLARIFY --> O_END
    end

    subgraph TYPE_GRAPH["DOCUMENT_TYPE_GRAPH｜由 classify_question 呼叫"]
        D_START((START)) --> D_CLASSIFY["classify_question<br/>LLM 分類意圖、用途與參考 D 類型"]
        D_CLASSIFY --> D_RESOLVE["resolve_document_type"]
        D_RESOLVE --> D_END((END))
    end

    subgraph PURPOSE_GRAPH["PURPOSE_WORKFLOW_GRAPH｜由 classified 呼叫"]
        P_START((START)) --> P_STRATEGY["route_purpose_strategy"]
        P_STRATEGY --> P_PLAN["plan_each_purpose"]
        P_PLAN --> P_MERGE["merge_purpose_sections<br/>多用途時由 LLM 合併"]
        P_MERGE --> P_OUTLINE["draft_unified_outline"]
        P_OUTLINE --> P_END((END))
    end

    O_CLASSIFY -.->|呼叫| D_START
    D_END -.->|回傳分類結果| O_INTENT
    O_CLASSIFIED -.->|呼叫| P_START
    P_END -.->|回傳計畫與大綱| O_END
    READ_STATE --> O_START
    O_END --> SAVE_STATE

    subgraph DOCX_API["下載目前版本 DOCX"]
        API_GENERATE["POST /api/report-generator/threads/{thread_id}/generate/stream"] --> DOCX_CHECK["驗證 confirmed=true，讀取使用者的 Thread"]
        DOCX_CHECK --> EXPORT["export_current_draft"]
        EXPORT --> SOURCE_GATE{"有大綱且 sourceMode 非 user_data？"}
        SOURCE_GATE -- 否 --> PROGRESS["匯出目前規劃與待補內容"]
        PROGRESS --> APPEND_LLM["文件末尾附上 LLM REQUEST／PROMPT／RESPONSE"]
        APPEND_LLM --> DOCX_RESULT["回傳 DOCX 檔案"]
    end

    subgraph DOCX_GRAPH["DOCX_CONTENT_GRAPH｜由 export_current_draft 呼叫"]
        X_START((START)) --> X_MATCH["match_metadata<br/>比對候選案例與大綱"]
        X_MATCH --> X_ROUTE{"找到相符且信心達 0.8 的案例？"}
        X_ROUTE -- 是 --> X_JSON["draft_from_json<br/>讀完整測試 JSON 並逐章撰寫"]
        X_ROUTE -- 否 --> X_OUTLINE["draft_from_outline<br/>LLM 依大綱撰寫，不讀測試 JSON"]
        X_JSON --> X_END((END))
        X_OUTLINE --> X_END
    end
    SOURCE_GATE -- 是 --> X_START
    X_END --> APPEND_LLM

    subgraph QUICK_API["範例需求｜不進 LangGraph"]
        API_QUICK["GET /api/report-generator/quick-starts"] --> QUICK_DATA["讀取快捷問題清單"]
        QUICK_DATA --> QUICK_RESULT["回傳快捷問題"]
    end

    UI_REPORT --> API_THREADS
    UI_REPORT --> API_QUICK
    UI_REPORT --> NEW_THREAD["新對話：前端建立 UUID，尚不呼叫 API"]
    THREADS_RESULT --> SELECT_THREAD["選取既有對話"]
    SELECT_THREAD --> DISPLAY_THREAD["顯示對話與目前大綱"]
    NEW_THREAD --> COMPOSE["手動輸入需求或問題"]
    SELECT_THREAD --> COMPOSE
    QUICK_RESULT --> QUICK_PROMPT["空對話時點選範例需求"]
    COMPOSE --> API_MESSAGE
    QUICK_PROMPT -->|送出相同 content| API_MESSAGE
    MESSAGE_RESULT --> DISPLAY_THREAD
    MESSAGE_RESULT --> TRACE["最新 Graph Node 路徑存入 localStorage，供視窗檢視"]
    DISPLAY_THREAD --> DOWNLOAD_ACTION["有使用者訊息時按下載 DOCX"]
    DOWNLOAD_ACTION --> API_GENERATE
    DOCX_RESULT --> BROWSER_DOWNLOAD["瀏覽器下載 DOCX"]
    SELECT_THREAD -->|點選刪除| API_DELETE
    DELETE_RESULT --> UPDATE_THREADS["更新前端對話清單與 Graph 路徑"]
